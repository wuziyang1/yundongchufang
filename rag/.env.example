# rag/.env —— 知识库离线入库的配置（复制本文件为 rag/.env 后按需修改）
# 不建 rag/.env 也能跑：全部使用下面的默认值，嵌入密钥自动复用 backend/.env 里的 ZHIPU_API_KEY。

# ---- 知识库目录（留空 = rag/knowledge）----
RAG_KNOWLEDGE_DIR=
# 按文档定制的清洗规则文件（留空 = rag/doc_rules.toml）
RAG_DOC_RULES=

# ---- Milvus（rag/milvus/docker-compose.yml 与入库程序共用）----
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_MGMT_PORT=9091
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DATABASE=yundongchufang
MILVUS_COLLECTION=knowledge_chunks
MILVUS_INDEX_NAME=content_vector_hnsw
# Milvus 数据卷所在目录（留空 = rag/milvus/，数据落在 rag/milvus/volumes/）
DOCKER_VOLUME_DIRECTORY=

# ---- 嵌入模型 ----
# 在线检索时给查询文本做嵌入必须用同一个模型和维度，否则向量不可比
# 留空则复用 backend/.env 的 ZHIPU_API_KEY
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
# 智谱 embedding-3 默认 2048 维，必须下发 dimensions 才能得到 1024 维；
# 换成维度固定的模型（如 bge-m3）时改为 false
EMBEDDING_SEND_DIMENSIONS=true
EMBEDDING_BATCH_SIZE=16

# ---- 切片 ----
# 长度按「折算字数」计：汉字 1 个算 1，其余字符约 3 个算 1
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# ---- 扫描件 OCR（本地 RapidOCR，无需联网和密钥）----
ENABLE_PDF_OCR=true
OCR_DPI=200
