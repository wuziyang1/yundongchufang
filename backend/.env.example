# LLM 提供方：
#   anthropic_compatible  智谱 Anthropic 兼容端点
#   zhipu                 智谱 OpenAI 兼容端点
#   openai_compatible     本地部署或其他 OpenAI 兼容服务
#   mock                  离线占位假数据，仅供前端联调
LLM_PROVIDER=anthropic_compatible

# 智谱 Anthropic 兼容端点
ANTHROPIC_COMPAT_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_COMPAT_API_KEY=your_api_key_here
ANTHROPIC_COMPAT_MODEL=glm-5.3

# 智谱 OpenAI 兼容端点（同一把密钥可用）
ZHIPU_API_KEY=your_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-5.3

# 本地部署 / 其他 OpenAI 兼容服务（LLM_PROVIDER=openai_compatible 时生效）
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_COMPATIBLE_API_KEY=EMPTY
OPENAI_COMPATIBLE_MODEL=glm-4-9b-chat

# 生成参数。GLM-5.3 是思考模型：开启思考时约 80% 的输出 token 花在思考上，
# 实测一次完整流程（画像+处方）思考开 404s、思考关 84s，生成速度相同，差异全在 token 量。
# 用户等待时间不可接受，默认关闭；需要观察模型推理过程时再临时开启
# （开启后思考内容会流式显示在前端「AI 生成过程」面板）。
LLM_THINKING=false
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=65536
LLM_TIMEOUT=300

# 嵌入服务：默认复用上方 ZHIPU_API_KEY 与智谱 OpenAI 兼容端点，可单独覆盖。
# 查询向量必须与知识库入库时的模型、维度一致（embedding-3、1024 维）。
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024

# 知识库（Milvus）：项目根目录 rag/ 离线入库的国家标准、指南、手册、文献。
# 处方的专业依据只从这里取 —— 体测评分表、权威资料摘录、可选动作都来自它。
# 知识库不可用时处方不生成（LLM_PROVIDER=mock 离线联调除外）。
# 启动 Milvus：bash rag/scripts/milvus_up.sh；入库：bash rag/scripts/run_index.sh
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# MILVUS_USER=
# MILVUS_PASSWORD=
MILVUS_DATABASE=yundongchufang
MILVUS_COLLECTION=knowledge_chunks
# 一次处方的全部检索（评分表、摘录、动作）的总超时（秒）
KB_TIMEOUT=20

# 相关性把关：检索回来的内容是否真的回答了问题。候选由向量 + 关键词两路召回，再由重排模型
# 逐条打分，低于阈值的不注入 prompt，该问题记为「知识库未覆盖」。
# 默认用智谱 rerank（复用上方密钥），阈值按其原始分标定；针对个人的主题（短板、健康状况）再加 1。
# 换重排服务或嵌入模型后须重新标定：uv run python -u scripts/check_kb.py --all
KB_RERANK_ENABLED=true
# RERANK_API_KEY=
# RERANK_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
RERANK_MODEL=rerank
KB_RERANK_MIN_SCORE=17
# 重排关闭或不可用时退回向量相似度（COSINE）把关的阈值
KB_DENSE_MIN_SCORE=0.72

# 可选动作的筛选：学生不填器材清单，按普遍可得的器材过滤（徒手动作始终可用）。
# 器材名以知识库训练手册里的写法为准；学校有敏捷梯、药球等器材时加进来即可用到更多动作。
KB_EQUIPMENT=瑜伽垫,垫子,标志线,标志碟,锥形筒
# 写进 prompt 的动作条数上限
KB_EXERCISE_LIMIT=100
